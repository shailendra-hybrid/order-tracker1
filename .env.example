# copy to .env and edit; `sudo systemctl restart order-tracker` after changes to this file

# --- access (leave empty if nginx / VPN already protects the site) ---
AUTH_USER=
AUTH_PASS=

# --- n8n / ERP can start an order with: POST /api/hook/order  (header X-Api-Token) ---
HOOK_TOKEN=change-me-to-a-long-random-string

# --- "Open in ERP" button on ERP steps. {erp_ref} and {id} are replaced ---
ERP_URL_TEMPLATE=https://erp.example.com/orders/{erp_ref}

# --- optional: the tracker POSTs order.created / step.done / step.reopened here (e.g. an n8n webhook) ---
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- Telegram group per order (needs a logged-in user session, see README) ---
TG_ENABLED=false
TG_API_ID=
TG_API_HASH=
TG_TITLE_TEMPLATE={customer} | {id}
TG_ADD_USERS=@teammate1,@teammate2,@your_ops_bot

# --- deploy webhook (deploy/deploy.py): lets n8n's MCP tool (or GitHub Actions,
# or a plain curl) redeploy the container after code is pushed/edited on the VM ---
DEPLOY_TOKEN=change-me-to-a-long-random-string
DEPLOY_BRANCH=main
# COMPOSE_FILE=/opt/order-tracker/docker-compose.yml   # default: alongside this .env
# Caddy runs in a container (your n8n-stack) and reaches this over host.docker.internal,
# not loopback - only set this if that's your setup (see Caddyfile / README section 8):
# DEPLOY_HOST=0.0.0.0
