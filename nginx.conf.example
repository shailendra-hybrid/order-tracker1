# /etc/nginx/sites-available/order-tracker   (then: ln -s into sites-enabled, nginx -t, systemctl reload nginx)
server {
    listen 80;
    server_name tracker.example.internal;

    # basic auth in front of the whole UI (create with: htpasswd -c /etc/nginx/.tracker-htpasswd shail)
    auth_basic "Order Tracker";
    auth_basic_user_file /etc/nginx/.tracker-htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Remote-User $remote_user;   # shown as "by <user>" when a stage is completed
    }

    # n8n / ERP hook: protected by X-Api-Token instead of basic auth
    location /api/hook/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }

    # deploy webhook (deploy/deploy.py, port 8091 on the host): protected by its
    # own DEPLOY_TOKEN, so it stays reachable for n8n / GitHub Actions without
    # the UI's basic-auth password.
    location /deploy {
        auth_basic off;
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_read_timeout 15s;   # /deploy itself returns immediately either way
    }
}
